{
  "schema": 1,
  "contract_id": "xr-desktop/1.0-draft",
  "status": "draft_with_candidate_implementation_acceptance_pending",
  "released_ABI": false,
  "owner_repository": "xr-shell",
  "definition_owner": "xr-shell/protocols Rust SDK",
  "normative_draft": "../xr-desktop-protocol.md",
  "scope": {
    "M0": "definition and consistency review only",
    "M1": "does not implement or advertise component IPC",
    "first_implementation_phase": "M2",
    "M2_M4": "candidate implementation and isolated integration; final per-capability acceptance pending",
    "current_acceptance_target": "openKylin 3.0 native ARM64 development machine; all M2-M4 runtime gates pending",
    "historical_QEMU": "accepted M1 scope only; early M2-M4 candidate evidence does not transfer to the new target",
    "native_project_transfer_and_build": "completed verified full Git/cache migration and all five native builds; build evidence is separate from final runtime acceptance"
  },
  "transport": {
    "kind": "Unix SOCK_SEQPACKET",
    "socket_directory": "$XDG_RUNTIME_DIR/xr-desktop/",
    "directory_mode": "0700",
    "metadata_encoding": "bounded JSON",
    "fd_transport": "SCM_RIGHTS",
    "allowed_roles": [
      "dock",
      "system_ui",
      "window_server"
    ],
    "socket_default": "$XDG_RUNTIME_DIR/xr-desktop/shell.sock"
  },
  "version": {
    "major": 1,
    "minor": 0,
    "required_common_capability": "core.v1",
    "unknown_major": "reject",
    "missing_required_capability": "reject"
  },
  "envelope": {
    "fields": [
      "type",
      "request_id",
      "session_generation",
      "component_id",
      "component_generation",
      "payload"
    ],
    "u64_wire_encoding": "decimal string",
    "float_values": "finite only",
    "fd_index": "index into ancillary FDs in the same datagram"
  },
  "capabilities": [
    {
      "id": "core.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "Hello",
        "Welcome",
        "Error",
        "SessionEnding"
      ]
    },
    {
      "id": "scene.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "SceneTransaction",
        "SceneApplied",
        "SceneRejected"
      ]
    },
    {
      "id": "snapshot.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "GetSnapshot",
        "Snapshot",
        "StateChanged",
        "WindowState",
        "WindowRemoved"
      ]
    },
    {
      "id": "input.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "InputEvent",
        "Cancel"
      ]
    },
    {
      "id": "shm.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "ShmBufferCommit",
        "BufferRelease"
      ]
    },
    {
      "id": "focus.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "FocusChanged",
        "FocusApplied",
        "SurfaceInput"
      ]
    },
    {
      "id": "window.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "WindowIntent",
        "RequestResult",
        "IntentAccepted"
      ]
    },
    {
      "id": "workspace.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "WorkspaceIntent",
        "WorkspaceApplied"
      ]
    },
    {
      "id": "system.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "SystemState",
        "TextCommit",
        "KeyIntent",
        "InputAccepted"
      ]
    },
    {
      "id": "clipboard.v1",
      "status": "candidate_implementation_acceptance_pending",
      "messages": [
        "GetClipboard",
        "ClipboardSet",
        "ClipboardChanged"
      ]
    }
  ],
  "limits": {
    "metadata_bytes": 65536,
    "transaction_operations": 128,
    "nodes_per_component": 512,
    "node_id_ascii_bytes": 64,
    "text_utf8_bytes": 2048,
    "shm_fds_per_commit": 1,
    "non_shm_message_fds": 0,
    "shm_max_dimension_px": 8192,
    "shm_max_bytes": 134217728,
    "damage_rectangles": 256
  },
  "scene": {
    "node_kinds": [
      "Group",
      "Card",
      "Text",
      "Icon",
      "Button",
      "Slider",
      "SurfaceReference"
    ],
    "operations": [
      "upsert_node",
      "remove_node",
      "set_root_policy"
    ],
    "root_policies": [
      "world_locked",
      "dock_lazy_follow"
    ],
    "revision_rule": "base_revision equals accepted revision; revision = base_revision + 1",
    "application": "atomic at frame boundary",
    "primitive_field_schema": "must be published by the SDK before reporting scene.v1 implemented",
    "node_id_pattern": "[A-Za-z0-9_-]{1,64}",
    "initial_root": "Shell-owned root, cannot be removed, revision 0, returned in Welcome",
    "spatial_panel": {
      "node_kind": "Group",
      "flag": "spatial_panel:true",
      "fields": [
        "logical_size",
        "size_m",
        "position_m",
        "rotation_degrees"
      ],
      "world_pose": "absolute STAGE, independent of component root world transform",
      "child_rect": "panel-local logical pixels",
      "rotation_degrees_order": [
        "Pitch",
        "Yaw",
        "Roll"
      ],
      "positive_pitch": "panel faces upward",
      "validation": "finite pose, positive bounded logical and physical size, valid parent tree required before atomic acceptance"
    },
    "visibility": "visible defaults true; false hides the full subtree from rendering and hit testing"
  },
  "snapshot": {
    "publisher": "xr-shell",
    "window_protocol_authority": "xr-wayland",
    "window_service_updates": [
      "WindowState",
      "WindowRemoved"
    ],
    "window_service_update_roles": [
      "window_server"
    ],
    "delta_revision": "continuous state_revision; gaps require a fresh Snapshot",
    "component_scene": "identity/revision/node_count/root metadata; full nodes require a bounded debug query",
    "clipboard": "bounded preview/bytes only; full selection is delivered by GetClipboard/ClipboardChanged",
    "owner_lifecycle": "system and clipboard state must be revoked when their owning component/generation disconnects"
  },
  "input": {
    "sources": [
      "controller_ray",
      "head_ray",
      "mouse"
    ],
    "phases": [
      "hover",
      "press",
      "drag",
      "release",
      "scroll"
    ],
    "capture_owner": "xr-shell",
    "capture_starts": "accepted press allocates capture_id",
    "capture_ends": [
      "release",
      "Cancel"
    ],
    "cancel_reasons": [
      "XR focus lost",
      "target removed",
      "source switched",
      "peer disconnected"
    ],
    "non_coalescible": [
      "press",
      "release",
      "Cancel",
      "focus changes",
      "snapshots"
    ]
  },
  "focus": {
    "spatial_owner": "xr-shell",
    "seat_grab_serial_owner": "xr-wayland",
    "epoch_owner": "xr-shell",
    "sequence": [
      "FocusChanged",
      "FocusApplied",
      "SurfaceInput with acknowledged focus_epoch"
    ],
    "stale_epoch": "reject; never retarget buffered keyboard input"
  },
  "shm": {
    "immutable_snapshot": true,
    "required_seals": [
      "F_SEAL_WRITE",
      "F_SEAL_GROW",
      "F_SEAL_SHRINK",
      "F_SEAL_SEAL"
    ],
    "formats": [
      "argb8888",
      "xrgb8888"
    ],
    "alpha_modes": [
      "premultiplied",
      "opaque"
    ],
    "colour_space": "srgb",
    "application_buffer_release": "after window service has finished copying the original wl_buffer",
    "snapshot_release": "exactly once after receiver has finished using that snapshot",
    "release_statuses": [
      "consumed",
      "superseded",
      "rejected",
      "surface_destroyed"
    ],
    "disconnect": "both peers close owned FDs without waiting for disconnected peer",
    "fd_close_on_exec": true,
    "format_alpha_pairs": {
      "argb8888": "premultiplied",
      "xrgb8888": "opaque"
    },
    "requires_registered_surface": true
  },
  "excluded_capabilities": [
    "DMA-BUF",
    "arbitrary shader injection",
    "direct OS control",
    "remote TCP",
    "hand tracking",
    "eye gaze"
  ],
  "acceptance": "Native handshake, identity and atomic/Group subsets verified; core-only broadcast failed on tested source and its fix still awaits native build/retest; no overall M2-M4 acceptance",
  "error_codes": [
    "unsupported_version",
    "missing_capability",
    "stale_generation",
    "stale_revision",
    "invalid_message",
    "wrong_role",
    "limit_exceeded",
    "unknown_surface",
    "stale_focus_epoch",
    "invalid_buffer"
  ],
  "sdk_candidate_version": "0.2.0",
  "native_socket_checks": {
    "source_commit": "50cebfe13d8c7bd7aed38ff54b89a25205af29eb",
    "passed_cases": [
      "normal_handshake_and_capability_intersection",
      "unsupported_major",
      "stale_session_identity",
      "atomic_rejection_and_valid_independent_group"
    ],
    "failed_case": "core_only_broadcast_capability_boundary",
    "failure": "core-only client received StateChanged without negotiated snapshot.v1",
    "raw_file": "contract-cases.json",
    "raw_sha256": "c6a67456b26c2bd5278dc46349b02239d85679c5d96a11cf22afd78348074f62",
    "raw_bytes": 152198,
    "full_raw_cached_locally": true,
    "own_hidden_scene_cleanup_verified": true,
    "no_window_workspace_focus_input_or_clipboard_operations": true,
    "routing_fix_source": "ce9835d8c5c6dcf2850db27be29b72eabce5dc77",
    "routing_fix_native_acceptance": "pending"
  }
}
